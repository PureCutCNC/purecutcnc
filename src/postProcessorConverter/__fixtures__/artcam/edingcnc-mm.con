;
; Zehe Machines PostP file for EDING USBCNC
;
; History
;
; Who 	When     	What
; ==	========== 	========================================
; 
; AZ	2015-01-09	CREATED NEW POST
;			DO NOT USE HOME OPTION IN ArtCAM 
;			HOMING AT END TO ZH THEN XH YH 
;			USER 1-4 BEFORE TOOLCHANGE
;			USER 5-8 AFTER TOOLCHANGE
;			MATERIAL DIMENSIONS AT START
;			ZH AFTER TOOLPATH SEGMENT
;			FIRST RAPID TO X Y THEN SZ
; AZ	2015-04-01	ADDED ALLOW_HELICAL_ARCS 		;	
;
DESCRIPTION = "EdingCNC-CNC-INCH(*.CNC)"
;
FILE_EXTENSION = "CNC"
;
UNITS = MM
;
; Cariage return - line feed at end of each line
;
END_OF_LINE = "[13][10]"
;
; Block numbering 
LINE_NUM_START     = 0
LINE_NUM_INCREMENT = 10
LINE_NUM_MAXIMUM   = 999999
;
; Set up default formating for variables
;
; Line numbering
FORMAT = [N|@||1.0]
;
; Spindle Speed
FORMAT = [S|@||1.0]
;
; Feed Rate
FORMAT = [F|#| F|1.1]
;
; Tool moves in X, Y, and Z
FORMAT = [X|#| X|1.3]
FORMAT = [Y|#| Y|1.3]
FORMAT = [Z|#| Z|1.3]
;
;
; Home tool positions
FORMAT = [XH|@|X|1.3]
FORMAT = [YH|@|Y|1.3]
FORMAT = [ZH|@|Z|1.3]
FORMAT = [SZ|@|Z|1.3]
;
; Tool Number
FORMAT = [T|@||1.0]
;
; Set up program header
;
START = "([FILENAME][FILEEXTENSIONU])"
START = "(MATERIAL SIZE)"
START = "(X : [XSIZE], MIN: [XMIN], MAX: [XMAX])"
START = "(Y : [YSIZE], MIN: [YMIN], MAX: [YMAX])"
START = "(Z : [ZMATERIAL], MIN: [ZMATERIAL_BOTTOM], MAX: [ZMATERIAL_TOP])"
START = "(HOME POSITION = [XH] [YH] [ZH])"
START = "(SAFE Z = [SZ])"
START = "G90G80G21G49"
;
; Program moves
;
RETRACT_MOVE           = "G0 [SZ]"
;
FIRST_RAPID_RATE_MOVE  = "G0[X][Y][13][10]  [Z]"
RAPID_RATE_MOVE	       = "  [X][Y][Z]"
;
FIRST_FEED_RATE_MOVE   = "G1[X][Y][Z][F]"
FEED_RATE_MOVE         = "  [X][Y][Z]"
;
; Arc Moves
;
ALLOW_HELICAL_ARCS = YES
;
;MIN_ARC_LENGTH = 0.01
;
FIRST_CW_ARC_MOVE      = "G2[X][Y][Z] R[Radius][F]"
CW_ARC_MOVE            = "G2[X][Y][Z] R[Radius]"
;
FIRST_CCW_ARC_MOVE     = "G3[X][Y][Z] R[Radius][F]"
CCW_ARC_MOVE           = "G3[X][Y][Z] R[Radius]"
;
;
;Setup Toolchange Commands
;
FIRST_TOOLCHANGE = "G0 [ZH] [13][10]   [XH] [YH]"
FIRST_TOOLCHANGE = "[USER1U]"
FIRST_TOOLCHANGE = "[USER2U]"
FIRST_TOOLCHANGE = "[USER3U]"
FIRST_TOOLCHANGE = "[USER4U]"
FIRST_TOOLCHANGE = "M5"
FIRST_TOOLCHANGE = "M9"
FIRST_TOOLCHANGE = "G49"
FIRST_TOOLCHANGE = "M6 T[T]"
FIRST_TOOLCHANGE = "(Tool #[T]; [TOOL_DB_DESCU])"
FIRST_TOOLCHANGE = "(Spindle: [S] RPM)"
FIRST_TOOLCHANGE = "G43 H[T]"
FIRST_TOOLCHANGE = "G0 [ZH]"
FIRST_TOOLCHANGE = "M8"
FIRST_TOOLCHANGE = "M3 S[S]"
FIRST_TOOLCHANGE = "[USER5U]"
FIRST_TOOLCHANGE = "[USER6U]"
FIRST_TOOLCHANGE = "[USER7U]"
FIRST_TOOLCHANGE = "[USER8U]"
FIRST_TOOLCHANGE = "( BEGIN: [PARENT_TOOLPATHNAMEU] )"
;
NEW_SEGMENT_PRE_TOOLCHANGE = "( END TOOLPATH SEGMENT )"
NEW_SEGMENT_PRE_TOOLCHANGE = "G0 [ZH]"
NEW_SEGMENT_PRE_TOOLCHANGE = "[USER1U]"
NEW_SEGMENT_PRE_TOOLCHANGE = "[USER2U]"
NEW_SEGMENT_PRE_TOOLCHANGE = "[USER3U]"
NEW_SEGMENT_PRE_TOOLCHANGE = "[USER4U]"
;
TOOLCHANGE = "G0 [XH] [YH]"
TOOLCHANGE = "M5"
TOOLCHANGE = "M9"
TOOLCHANGE = "G49"
TOOLCHANGE = "M6 T[T]"
TOOLCHANGE = "(Tool #[T]; [TOOL_DB_DESCU])"
TOOLCHANGE = "(Spindle: [S] RPM)"
TOOLCHANGE = "G43 H[T]"
TOOLCHANGE = "G0 [ZH]"
;
NEW_SEGMENT_POST_TOOLCHANGE = "M8"
NEW_SEGMENT_POST_TOOLCHANGE = "M3 S[S]"
NEW_SEGMENT_POST_TOOLCHANGE = "[USER5U]"
NEW_SEGMENT_POST_TOOLCHANGE = "[USER6U]"
NEW_SEGMENT_POST_TOOLCHANGE = "[USER7U]"
NEW_SEGMENT_POST_TOOLCHANGE = "[USER8U]"
NEW_SEGMENT_POST_TOOLCHANGE = "( BEGIN: [PARENT_TOOLPATHNAMEU] )"

;
;End of file
END = "G0 [ZH]"
END = "G0 [XH] [YH]"
END = "M30"
; M30 = program end, spindle & coolants off and rewind