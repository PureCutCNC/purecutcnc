{
  "id": "grbl-plasma",
  "name": "Grbl plasma (OpenBuilds CONTROL) (experimental)",
  "description": "Experimental Grbl 1.1 plasma table with a touch-off probe and no THC, such as OpenBuilds CONTROL. The program probes the sheet before every cut and owns pierce height, delay and cut height. Torch sequencing is not yet implemented.",
  "builtin": true,
  "fileExtension": "gcode",
  "coordinateSystem": {
    "xAxis": "X",
    "yAxis": "Y",
    "zAxis": "Z"
  },
  "numberFormat": {
    "decimalPlaces": {
      "mm": 3,
      "inch": 4
    },
    "trailingZeros": true,
    "leadingZero": true
  },
  "units": {
    "mmCommand": "G21",
    "inchCommand": "G20"
  },
  "program": {
    "header": [
      "; {programName}",
      "; Generated by PureCutCNC on {date}",
      "; Experimental plasma output: not verified on a real plasma table",
      "G90",
      "G17",
      "{unitsCommand}",
      "{wcsCommand}"
    ],
    "operationHeader": [
      "; Operation {operationIndex}: {operationName}",
      "; Description: {operationDescription}",
      "; Tool {toolNumber}: {toolName}"
    ],
    "footer": [],
    "commentPrefix": ";",
    "commentSuffix": "",
    "lineNumbers": false,
    "lineNumberIncrement": 10
  },
  "workCoordinates": {
    "selectCommand": "G54"
  },
  "motion": {
    "rapidCommand": "G0",
    "linearCommand": "G1",
    "cwArcCommand": "G2",
    "ccwArcCommand": "G3",
    "arcFormat": "ij",
    "modalMotion": true,
    "arcInterpolation": true
  },
  "feedSpeed": {
    "feedCommand": "F",
    "rpmCommand": "",
    "spindleOnCW": "; Plasma sequencing pending (#983). Unused router RPM:",
    "spindleOnCCW": "; Plasma sequencing pending (#983). Unused router RPM:",
    "spindleOff": "",
    "inlineWithMotion": true,
    "modalFeedSpeed": true
  },
  "toolChange": {
    "commands": [],
    "stopSpindleFirst": false,
    "pauseAfterChange": false,
    "pauseCommand": "M0"
  },
  "cannedCycles": null,
  "coolant": null,
  "stop": {
    "programEndCommand": "M30"
  },
  "vendor": "Grbl",
  "machineKind": "plasma",
  "plasma": {
    "torchOnCommand": "M3 S1000",
    "torchOffCommand": "M5",
    "pierceMode": "gcode",
    "touchOff": {
      "probeCommand": "G38.2",
      "probeDepth": 30,
      "probeFeed": 100,
      "setZeroCommand": "G10 L20 P0",
      "switchOffset": 0
    }
  }
}
