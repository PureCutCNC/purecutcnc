{
  "id": "qtplasmac",
  "name": "QtPlasmaC (experimental)",
  "description": "Experimental QtPlasmaC plasma table. The controller material table owns pierce height, delay and THC. Torch sequencing is not yet implemented.",
  "builtin": true,
  "fileExtension": "ngc",
  "coordinateSystem": {
    "xAxis": "X",
    "yAxis": "Y",
    "zAxis": "Z"
  },
  "numberFormat": {
    "decimalPlaces": {
      "mm": 3,
      "inch": 4
    },
    "trailingZeros": true,
    "leadingZero": true
  },
  "units": {
    "mmCommand": "G21",
    "inchCommand": "G20"
  },
  "program": {
    "header": [
      "( {programName} )",
      "( Generated by PureCutCNC on {date} )",
      "G90 G17 G40 G49 G80 G94",
      "{unitsCommand}",
      "{wcsCommand}"
    ],
    "operationHeader": [
      "( Operation {operationIndex}: {operationName} )",
      "( Description: {operationDescription} )",
      "( Tool {toolNumber}: {toolName} )"
    ],
    "footer": [],
    "commentPrefix": "(",
    "commentSuffix": ")",
    "lineNumbers": false,
    "lineNumberIncrement": 10
  },
  "workCoordinates": {
    "selectCommand": "G54"
  },
  "motion": {
    "rapidCommand": "G0",
    "linearCommand": "G1",
    "cwArcCommand": "G2",
    "ccwArcCommand": "G3",
    "arcFormat": "ij",
    "modalMotion": true,
    "arcInterpolation": true
  },
  "feedSpeed": {
    "feedCommand": "F",
    "rpmCommand": "",
    "spindleOnCW": "; Plasma sequencing pending (#959). Unused router RPM:",
    "spindleOnCCW": "; Plasma sequencing pending (#959). Unused router RPM:",
    "spindleOff": "",
    "inlineWithMotion": true,
    "modalFeedSpeed": true
  },
  "toolChange": {
    "commands": [],
    "stopSpindleFirst": false,
    "pauseAfterChange": false,
    "pauseCommand": "M0"
  },
  "cannedCycles": null,
  "coolant": null,
  "stop": {
    "programEndCommand": "M2"
  },
  "vendor": "LinuxCNC",
  "machineKind": "plasma",
  "plasma": {
    "torchOnCommand": "M3 $0 S1",
    "torchOffCommand": "M5 $0",
    "materialSelectCommand": "M190 P{materialNumber}",
    "thcOnCommand": "M63 P2",
    "thcOffCommand": "M62 P2",
    "pierceMode": "controller"
  }
}
